# Read-only token for the InfluxDB bucket "server_data". Never commit it.
KIOSK_INFLUX_TOKEN=

# Optional, defaults shown:
# KIOSK_PORT=8088
# PLATFORM_NETWORK=2526-4ahitm-leoiot-dashboard_leoiot

# SolaX collector (service "collector", Compose profile "collector"). All values are required
# when the collector runs; never commit them.
# Test or shadow runs use the defaults below: bucket pv_shadow, publishing off.
COLLECTOR_SOLAX_CLIENT_ID=
COLLECTOR_SOLAX_CLIENT_SECRET=
COLLECTOR_SOLAX_USERNAME=
COLLECTOR_SOLAX_PASSWORD=
COLLECTOR_SOLAX_PLANT_ID=
# Write-only InfluxDB token for the target bucket.
COLLECTOR_INFLUX_TOKEN=
COLLECTOR_MQTT_USER=
COLLECTOR_MQTT_PASSWORD=

# Optional, defaults shown:
# COLLECTOR_INFLUX_BUCKET=pv_shadow
# COLLECTOR_PUBLISH=0
# COLLECTOR_INFLUX_URL=http://influxdb:8086
# COLLECTOR_INFLUX_ORG=leoiot
# COLLECTOR_MQTT_URL=mqtt://mosquitto:1883
# COLLECTOR_SOLAX_BASE_URL=https://openapi-eu.solaxcloud.com
# COLLECTOR_INTERVAL_MS=60000
# COLLECTOR_HEALTH_FILE=/tmp/collector-last-delivery
