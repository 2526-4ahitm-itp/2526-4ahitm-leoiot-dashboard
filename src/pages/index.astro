---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/marketing/SiteNav.astro';
import Hero from '../components/marketing/Hero.astro';
import Bento from '../components/marketing/Bento.astro';
import DataFlow from '../components/marketing/DataFlow.astro';
import SiteFooter from '../components/marketing/SiteFooter.astro';
---

<BaseLayout
  path=""
  title="LeoIoT – Wie gut ist die Luft in unserer Schule?"
  description="LeoIoT: Ein 3D-Modell der HTL Leonding zeigt live das Raumklima der angebundenen Räume und die Daten der Solaranlage."
  lang="de"
>
  <SiteNav slot="header" lang="de" current="product" />
  <div class="mk-wrap">
    <Hero lang="de" />
    <Bento lang="de" />
  </div>
  <DataFlow lang="de" />
  <SiteFooter slot="footer" lang="de" />
</BaseLayout>
