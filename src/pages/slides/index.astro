---
import '../../styles/tokens.css';
import ThemeToggle from '../../components/ThemeToggle.astro';
import slidesRaw from '../../slides/slides.html?raw';

// Diagramm-SVGs (einmalig aus src/slides/diagrams/*.puml gerendert) per Dateiname auflösen.
const svgs = import.meta.glob('../../slides/diagrams/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;

let slides = slidesRaw;
for (const [path, url] of Object.entries(svgs)) {
  const name = path.split('/').pop()!;
  slides = slides.replaceAll(`src="${name}"`, `src="${url}"`);
}

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="de" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>LeoIoT – Präsentation</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('starlight-theme'); } catch (e) {}
        document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="back-link" href={base}>Zurück zur Seite</a>
    <div class="slides-theme-toggle"><ThemeToggle label="Hell/Dunkel umschalten" /></div>
    <div class="reveal">
      <div class="slides">
        <Fragment set:html={slides} />
      </div>
    </div>

    <script>
      import Reveal from 'reveal.js';
      import 'reveal.js/reveal.css';
      import 'reveal.js/theme/white.css';
      import '../../slides/slides.css';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      Reveal.initialize({
        width: 1408,
        height: 792,
        slideNumber: 'c/t',
        transition: reduceMotion ? 'none' : 'slide',
        backgroundTransition: reduceMotion ? 'none' : 'fade',
        hash: true,
      });
    </script>
  </body>
</html>
