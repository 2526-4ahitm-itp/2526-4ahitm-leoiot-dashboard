---
/* Stilisierte Illustrationen (keine Screenshots, keine echten Daten). Nur Token-Farben. */
interface Props {
  kind: 'explorer' | 'dashboard' | 'pv' | 'kiosk';
  label: string;
  lang?: 'de' | 'en';
}
const { kind, label, lang = 'de' } = Astro.props;
const chips = lang === 'en' ? ['OK', 'Medium', 'Alert'] : ['OK', 'Mittel', 'Alarm'];
---

<figure class="ap-fig" aria-hidden="true">
  <div class="ap-frame">
    <div class="ap-bar"><i></i><i></i><i></i><span class="ap-tag">{label}</span></div>
    <div class="ap-canvas">
      {kind === 'explorer' && (
        <div class="ap-ex">
          <div class="ap-pills"><b></b><b class="on"></b><b></b><b></b><b></b></div>
          <svg viewBox="0 0 240 150" class="ap-svg" focusable="false">
            <g stroke="var(--wall-s)" stroke-width="1.2" stroke-linejoin="round">
              <path d="M40 104 120 144 200 104 120 64Z" fill="var(--wall-t)"></path>
              <path d="M40 104v10l80 40v-10Z" fill="var(--wall-l)"></path>
              <path d="M200 104v10l-80 40v-10Z" fill="var(--wall-r)"></path>
              <path d="M40 78 120 118 200 78 120 38Z" fill="var(--wall-t)"></path>
              <path d="M40 78v10l80 40v-10Z" fill="var(--wall-l)"></path>
              <path d="M200 78v10l-80 40v-10Z" fill="var(--wall-r)"></path>
              <path d="M40 52 120 92 200 52 120 12Z" fill="var(--wall-t)"></path>
              <path d="M40 52v10l80 40v-10Z" fill="var(--wall-l)"></path>
              <path d="M200 52v10l-80 40v-10Z" fill="var(--wall-r)"></path>
            </g>
            <path class="ap-room a" d="M96 40 120 52 144 40 120 28Z" fill="var(--g)"></path>
            <path class="ap-room b" d="M130 56 154 68 178 56 154 44Z" fill="var(--y)"></path>
            <path class="ap-room c" d="M62 56 86 68 110 56 86 44Z" fill="var(--r)"></path>
          </svg>
          <div class="ap-card"><span class="ap-ln w60"></span><span class="ap-ln w40"></span></div>
        </div>
      )}
      {kind === 'dashboard' && (
        <div class="ap-db">
          <div class="ap-tiles"><span></span><span></span><span></span><span></span></div>
          <svg viewBox="0 0 240 70" class="ap-svg" focusable="false">
            <path d="M0 55 30 48 60 52 90 30 120 36 150 22 180 28 210 14 240 18" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
            <path d="M0 62 40 58 80 60 120 50 160 54 200 46 240 48" fill="none" stroke="var(--ink-3)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path>
            <path d="M0 68H240" stroke="var(--line)"></path>
          </svg>
          <div class="ap-rows">
            <div><span class="ap-ln w30"></span><em class="mk-chip g">{chips[0]}</em></div>
            <div><span class="ap-ln w40"></span><em class="mk-chip y">{chips[1]}</em></div>
            <div><span class="ap-ln w20"></span><em class="mk-chip r">{chips[2]}</em></div>
          </div>
        </div>
      )}
      {kind === 'pv' && (
        <div class="ap-pv">
          <div class="ap-tiles"><span></span><span></span><span></span><span></span></div>
          <svg viewBox="0 0 240 80" class="ap-svg" focusable="false">
            <g fill="var(--accent)" opacity=".85">
              <rect x="10" y="52" width="22" height="26" rx="3"></rect><rect x="42" y="40" width="22" height="38" rx="3"></rect>
              <rect x="74" y="26" width="22" height="52" rx="3"></rect><rect x="106" y="14" width="22" height="64" rx="3"></rect>
              <rect x="138" y="22" width="22" height="56" rx="3"></rect><rect x="170" y="38" width="22" height="40" rx="3"></rect>
              <rect x="202" y="56" width="22" height="22" rx="3"></rect>
            </g>
            <path d="M0 79H240" stroke="var(--line-2)"></path>
          </svg>
        </div>
      )}
      {kind === 'kiosk' && (
        <div class="ap-ki">
          <div class="ap-kp">
            <svg viewBox="0 0 60 60" class="ap-svg" focusable="false"><circle cx="30" cy="30" r="20" fill="none" stroke="var(--line-2)" stroke-width="9"></circle><circle cx="30" cy="30" r="20" fill="none" stroke="var(--accent)" stroke-width="9" stroke-dasharray="78 126" transform="rotate(-90 30 30)"></circle></svg>
          </div>
          <div class="ap-kp">
            <svg viewBox="0 0 60 60" class="ap-svg" focusable="false"><g fill="var(--accent)" opacity=".85"><rect x="6" y="30" width="6" height="24" rx="1.5"></rect><rect x="16" y="22" width="6" height="32" rx="1.5"></rect><rect x="26" y="14" width="6" height="40" rx="1.5"></rect><rect x="36" y="20" width="6" height="34" rx="1.5"></rect><rect x="46" y="34" width="6" height="20" rx="1.5"></rect></g></svg>
          </div>
          <div class="ap-kp">
            <svg viewBox="0 0 60 60" class="ap-svg" focusable="false"><path d="M4 52C16 52 18 14 30 14S44 52 56 52" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round"></path><path d="M4 54H56" stroke="var(--line-2)"></path></svg>
          </div>
          <div class="ap-kp">
            <svg viewBox="0 0 60 60" class="ap-svg" focusable="false"><g stroke="var(--accent)" stroke-width="1.6" class="ap-flow"><path d="M30 14V28M12 30H27M48 30H33M30 48V33"></path></g><g fill="var(--surface)" stroke="var(--ink-3)" stroke-width="1.4"><circle cx="30" cy="10" r="5"></circle><circle cx="9" cy="30" r="5"></circle><circle cx="51" cy="30" r="5"></circle><circle cx="30" cy="51" r="5"></circle></g></svg>
          </div>
        </div>
      )}
    </div>
  </div>
</figure>

<style is:global>
  .ap-fig { margin: 0; min-width: 0; }
  .ap-frame { border: var(--bw) solid var(--line); border-radius: var(--r-frame); background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
  .ap-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--bg-soft); border-bottom: var(--bw) solid var(--line); }
  .ap-bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-2); }
  .ap-tag { margin-left: auto; font-size: var(--fs-meta); color: var(--ink-3); text-align: right; }
  .ap-canvas { padding: var(--space-4); background: var(--bg); }
  .ap-svg { display: block; width: 100%; height: auto; }
  .ap-ln { display: block; height: 8px; border-radius: 4px; background: var(--line-2); }
  .ap-ln.w20 { width: 20%; } .ap-ln.w30 { width: 30%; } .ap-ln.w40 { width: 40%; } .ap-ln.w60 { width: 60%; }
  .ap-pills { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--space-2); }
  .ap-pills b { width: 38px; height: 18px; border-radius: var(--r-pill); border: var(--bw) solid var(--line-2); background: var(--surface); }
  .ap-pills b.on { background: var(--accent-soft); border-color: var(--accent); }
  .ap-card { margin-top: var(--space-2); display: grid; gap: 8px; padding: 12px; border: var(--bw) solid var(--line); border-radius: var(--r-md); background: var(--bg-soft); }
  .ap-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-bottom: var(--space-3); }
  .ap-tiles span { height: 34px; border: var(--bw) solid var(--line); border-radius: var(--r-md); background: var(--bg-soft); }
  .ap-rows { display: grid; gap: 6px; margin-top: var(--space-2); }
  .ap-rows > div { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 10px; border: var(--bw) solid var(--line); border-radius: var(--r-md); background: var(--surface); }
  .ap-rows em { font-style: normal; }
  .ap-ki { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .ap-kp { padding: 12px; border: var(--bw) solid var(--line); border-radius: var(--r-md); background: var(--bg-soft); }
  .ap-kp .ap-svg { max-height: 96px; }
  @media (prefers-reduced-motion: no-preference) {
    .ap-room { animation: ap-breathe 5s ease-in-out infinite alternate; }
    .ap-room.b { animation-delay: -2s; }
    .ap-flow path { stroke-dasharray: 4 4; animation: ap-dash 2.4s linear infinite; }
  }
  @keyframes ap-breathe { to { opacity: 0.8; } }
  @keyframes ap-dash { to { stroke-dashoffset: -16; } }
  @media (prefers-reduced-motion: reduce) { .ap-room, .ap-flow path { animation: none !important; } }
</style>
