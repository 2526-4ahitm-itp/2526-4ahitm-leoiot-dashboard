---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'de' | 'en';
}
const { title, description = '', lang = 'de' } = Astro.props;
const skip = lang === 'en' ? 'Skip to content' : 'Zum Inhalt springen';
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('starlight-theme'); } catch (e) {}
        document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
      })();
    </script>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: var(--fw-regular) var(--fs-base) / var(--lh-base) var(--font-sans);
        transition: background-color var(--dur-theme) ease, color var(--dur-theme) ease;
      }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
      .skip { position: absolute; left: -999px; top: 8px; background: var(--ink); color: var(--bg); padding: 8px 12px; border-radius: 8px; z-index: var(--z-skip); }
      .skip:focus { left: 8px; }
      main:focus { outline: none; }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">{skip}</a>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
