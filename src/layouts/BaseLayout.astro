---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'de' | 'en';
  /** Pfad der Seite ohne Sprachpräfix, z. B. '' oder 'app/'. Ohne Angabe: kein canonical/hreflang. */
  path?: string;
}
const { title, description = '', lang = 'de', path } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = (Astro.site ?? new URL('http://localhost')).origin;
const abs = (p: string) => `${origin}${base}/${p}`;
const hasPath = path !== undefined;
const urlDe = hasPath ? abs(path) : '';
const urlEn = hasPath ? abs(`en/${path}`) : '';
const url = lang === 'en' ? urlEn : urlDe;
const skip = lang === 'en' ? 'Skip to content' : 'Zum Inhalt springen';
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {hasPath && <link rel="canonical" href={url} />}
    {hasPath && <link rel="alternate" hreflang="de" href={urlDe} />}
    {hasPath && <link rel="alternate" hreflang="en" href={urlEn} />}
    {hasPath && <link rel="alternate" hreflang="x-default" href={urlDe} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang} />
    <meta property="og:site_name" content="LeoIoT" />
    {hasPath && <meta property="og:url" content={url} />}
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('starlight-theme'); } catch (e) {}
        document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
      })();
    </script>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: var(--fw-regular) var(--fs-base) / var(--lh-base) var(--font-sans);
        transition: background-color var(--dur-theme) ease, color var(--dur-theme) ease;
      }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
      .skip { position: absolute; left: -999px; top: 8px; background: var(--ink); color: var(--bg); padding: 8px 12px; border-radius: 8px; z-index: var(--z-skip); }
      .skip:focus { left: 8px; }
      main:focus { outline: none; }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">{skip}</a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
