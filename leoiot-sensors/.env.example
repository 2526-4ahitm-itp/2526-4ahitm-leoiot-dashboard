# Template for leoiot-sensors/.env. Copy it to .env on the host and fill in the
# values; never commit them.

# Read-only InfluxDB token for the bucket "server_data", used by the dashboard.
SENSORS_DASHBOARD_INFLUX_TOKEN=

# Optional, defaults shown:
# Host port of the dashboard, bound to 127.0.0.1.
# SENSORS_DASHBOARD_PORT=8092
# File with the collector's secrets (SENSORS_INFLUX_TOKEN, SENSORS_MQTT_USER,
# SENSORS_MQTT_PASSWORD). It lies outside the checkout.
# SENSORS_COLLECTOR_ENV_FILE=/home/solmqadmin/leoiot-host-secrets/sensors-collector.env
# Network shared with the broker and InfluxDB.
# PLATFORM_NETWORK=2526-4ahitm-leoiot-dashboard_leoiot
